{
  "name": "@ivaninvladimir/vue-stylebook-workspace",
  "version": "0.5.1",
  "private": true,
  "homepage": "https://github.com/VladimirIvanin/vue-stylebook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirIvanin/vue-stylebook.git"
  },
  "bugs": {
    "url": "https://github.com/VladimirIvanin/vue-stylebook/issues"
  },
  "scripts": {
    "changeset": "changeset",
    "pretest": "pnpm lint",
    "test": "pnpm test:vitest run && pnpm test:plugin && pnpm test:vue3 run",
    "test:plugin": "pnpm compile && node ./packages/vue-inbrowser-compiler-demi/postinstall.js && rimraf test/cli-packages/* && vitest run -c vitest.config.plugin.ts",
    "test:vitest": "node ./packages/vue-inbrowser-compiler-demi/postinstall.js && vitest --config vitest.config.ts",
    "test:vue3": "pnpm install:vue3 && vitest --config vitest.config.vue3.ts",
    "install:vue3": "pnpm install --ignore-scripts --filter ./packages/vue-inbrowser-compiler-demi --save-dev vue@3 && node ./packages/vue-inbrowser-compiler-demi/postinstall.js --vue3",
    "test:perf": "node ./packages/vue-docgen-api/tests/perf-test.js",
    "posttest": "pnpm format",
    "format": "prettier --write docs packages/**/*.{js,md,vue,ts,tsx} examples/**/*.{js,md,vue,ts}",
    "test:coverage": "vitest --coverage",
    "start": "./start.sh server",
    "prebuild": "pnpm compile",
    "build": "./start.sh build",
    "prelint": "pnpm compile",
    "lint": "eslint . --cache --fix --ext .ts,.tsx,.js --cache-location node_modules/.eslint_cache/",
    "compile": "turbo run compile",
    "prepack": "pnpm compile",
    "test:browser": "node test/browser.mjs",
    "precommit": "lint-staged",
    "cy:open": "cypress open",
    "cy:ct": "cypress open --component -C packages/vue-stylebook-engine/cypress.config.ts",
    "cy:ct:vue3": "pnpm install:vue3 && cypress open --component -C packages/vue-stylebook-engine/cypress.config.vue3.ts",
    "cy:ct:prismjs": "node ./packages/vue-inbrowser-compiler-demi/postinstall.js && cypress open --component -C packages/vue-inbrowser-prismjs-highlighter/cypress.config.ts",
    "cy:ct:prismjs:vue3": "pnpm install:vue3 && cypress open --component -C packages/vue-inbrowser-prismjs-highlighter/cypress.config.vue3.ts",
    "cy:serve": "node test/run.server.js",
    "cy:run": "cypress run --e2e --spec \"test/cypress/integration/$CY_EXAMPLE_FOLDER/*.cy.ts\"",
    "cy": "start-server-and-test cy:serve http://localhost:6060 cy:run",
    "predocs": "node ./docs/.vuepress/preprocess.js",
    "docs": "vuepress dev docs",
    "docs:build": "node ./docs/.vuepress/preprocess.js && vuepress build docs",
    "maketypes": "babel packages/vue-stylebook-engine/src/scripts/schemas/config.ts --out-file packages/vue-stylebook-engine/lib/scripts/schemas/config.js && node packages/vue-stylebook-engine/maketypes.js",
    "publish:npm": "pnpm compile && pnpm publish packages/vue-stylebook-engine --access public --no-git-checks && pnpm publish packages/npm-bridge --access public --no-git-checks",
    "publish:npm:dry": "pnpm compile && pnpm publish packages/vue-stylebook-engine --dry-run --access public --no-git-checks && pnpm publish packages/npm-bridge --dry-run --access public --no-git-checks"
  },
  "license": "MIT",
  "engines": {
    "node": ">=10",
    "npm": ">=5"
  },
