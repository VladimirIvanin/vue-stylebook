  "keywords": [
    "vue",
    "styleguide",
    "style guide",
    "documentation",
    "docs",
    "generator",
    "component",
    "components"
  ],
  "lint-staged": {
    "(*.js|*.ts)": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.md": [
      "prettier --write",
      "git add"
    ],
    "packages/vue-stylebook-engine/src/scripts/schemas/config.ts": [
      "pnpm run maketypes",
      "git add ./packages/vue-stylebook-engine/src/types/StyleGuide.ts"
    ]
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Opera versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 1 Safari version",
    "IE >= 11"
  ],
